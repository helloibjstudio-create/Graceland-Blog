# Copy to .env.local for local dev, or paste these into Vercel → Settings →
# Environment Variables. Generate real values with:
#
#   npm run admin:create -- you@gracelandpsychiatry.com "a-strong-password"
#
# It writes .env.local for you; copy the three values from there into Vercel.

# HMAC key for admin session cookies and signed preview links (32+ random bytes).
AUTH_SECRET=

# The single admin account allowed into /admin.
ADMIN_EMAIL=

# scrypt hash of the admin password, in "salt:hash" form.
# The plaintext password is never stored anywhere.
ADMIN_PASSWORD_HASH=
